# 复制为 .env 后填密钥。程序只读 .env，不读本文件。

# ============================ 文本段（必填其一）============================
# 复用 scaffold 的 Anthropic-compatible 通道
ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================ 视觉段（三选一）=============================
# 三家都是 OpenAI 兼容接口，只换 base_url / key / model。
# 默认 provider：qwen_vl
VISION_PROVIDER=qwen_vl

# --- 候选 1：Qwen-VL（阿里云百炼）---
DASHSCOPE_API_KEY=sk-xxx
QWEN_VL_MODEL=qwen-vl-max
# QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 候选 2：豆包 Vision（火山方舟）---
ARK_API_KEY=xxx
# 方舟通常填推理接入点 ID（ep-xxxx），或模型名
DOUBAO_VISION_MODEL=
# DOUBAO_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 候选 3：GLM-4V（智谱）---
ZHIPU_API_KEY=xxx
GLM_4V_MODEL=glm-4v-plus
# GLM_4V_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============================ 第三方内容 API ==============================
# 实采：Apify。Actor 是秒级~分钟级重操作，所以**不在用户链路里实时调**，
# 先用 scripts/refresh_content_cache.py 预热缓存；用户流程只读 data/content_cache.json。
APIFY_TOKEN=
# 小红书数据 API（operation=search_notes）
APIFY_ACTOR_ID=socialdatax~socialdatax-xhs-data-api
# 抖音（如需接入再启用）
APIFY_ACTOR_DOUYIN=zen-studio~douyin-profile-scraper
APIFY_MAX_ITEMS=20
APIFY_TIMEOUT_SECONDS=120
APIFY_MEMORY_MB=1024
# 计费：$0.00005/次启动 + $0.00499/条（≈ ¥0.036/条）
APIFY_PRICE_PER_ITEM_USD=0.00499

# 是否允许用户链路实时抓取（默认 false：只读缓存）
CONTENT_LIVE=false
CONTENT_CACHE_TTL_HOURS=168

# --- 备用：非 Apify 的通用 JSON 接口（留口，便于换供应商）---
CONTENT_API_BASE_URL=
CONTENT_API_KEY=
CONTENT_API_KEY_HEADER=Authorization
CONTENT_API_KEY_PREFIX=Bearer 
# 通用接口的短超时（Apify 不走这里）
CONTENT_API_TIMEOUT_SECONDS=3.0
CONTENT_API_MAX_RETRIES=1
CONTENT_API_FALLBACK=true

# ============================ 演示 / 调参 =================================
# true = 全链路离线（视觉与内容都走 mock），现场演示最稳
DEMO_OFFLINE=false
VISION_TIMEOUT_SECONDS=20
VISION_MIN_CONFIDENCE=0.35
# 视觉预热等待上限（秒）：超过就降级返回，绝不让 Web 请求无限阻塞
VISION_PREFETCH_WAIT_SECONDS=45
# 单次视觉分析的重试次数（>1 才生效）。重试会把超时放大，默认 1 = 不重试
VISION_MAX_ATTEMPTS=1
# Web 端口（默认 8765）
WEB_PORT=8765
MAX_TOKENS=4000
TIMEOUT_SECONDS=60
MAX_RETRIES=2
